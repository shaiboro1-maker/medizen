{
  "name": "CRMContact",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea \u05dc\u05e1\u05d9\u05d5\u05d5\u05d2"
    },
    "status": {
      "type": "string",
      "enum": [
        "lead",
        "active",
        "inactive",
        "vip"
      ],
      "default": "lead"
    },
    "source": {
      "type": "string",
      "description": "\u05de\u05d4\u05d9\u05db\u05df \u05d4\u05d2\u05d9\u05e2 \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "total_appointments": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "last_appointment_date": {
      "type": "string",
      "format": "date"
    },
    "next_appointment_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "custom_fields": {
      "type": "object",
      "description": "\u05e9\u05d3\u05d5\u05ea \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea"
    }
  },
  "required": [
    "therapist_id",
    "client_email"
  ]
}