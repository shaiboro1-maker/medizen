{
  "name": "BulletinPost",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "collaboration",
        "equipment_sale",
        "clinic_rental",
        "jobs",
        "other"
      ]
    },
    "price": {
      "type": "number"
    },
    "area": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_info": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "expired",
        "rejected"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "is_promoted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category"
  ]
}