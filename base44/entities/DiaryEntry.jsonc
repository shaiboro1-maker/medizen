{
  "name": "DiaryEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "mood": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "okay",
        "bad",
        "terrible"
      ],
      "description": "\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d9\u05d5\u05de\u05df"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea (\u05db\u05d0\u05d1, \u05e9\u05d9\u05e0\u05d4, \u05ea\u05e8\u05d2\u05d5\u05dc \u05d5\u05db\u05d5')"
    },
    "pain_level": {
      "type": "number",
      "description": "\u05e8\u05de\u05ea \u05db\u05d0\u05d1 0-10"
    },
    "energy_level": {
      "type": "number",
      "description": "\u05e8\u05de\u05ea \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 0-10"
    }
  },
  "required": [
    "user_email",
    "date",
    "content"
  ]
}