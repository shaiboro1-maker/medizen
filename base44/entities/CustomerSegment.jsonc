{
  "name": "CustomerSegment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e4\u05d9\u05dc\u05d5\u05d7"
    },
    "description": {
      "type": "string"
    },
    "criteria": {
      "type": "object",
      "properties": {
        "min_appointments": {
          "type": "number"
        },
        "max_appointments": {
          "type": "number"
        },
        "min_orders": {
          "type": "number"
        },
        "max_orders": {
          "type": "number"
        },
        "min_spent": {
          "type": "number"
        },
        "max_spent": {
          "type": "number"
        },
        "preferred_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_activity_days": {
          "type": "number",
          "description": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1-X \u05d9\u05de\u05d9\u05dd \u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "customer_count": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05d1\u05e4\u05d9\u05dc\u05d5\u05d7"
    },
    "created_by": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "criteria"
  ]
}