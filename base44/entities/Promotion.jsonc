{
  "name": "Promotion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d1\u05e6\u05e2"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "service",
        "product",
        "both"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d1\u05e6\u05e2"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d5 \u05e1\u05db\u05d5\u05dd \u05e7\u05d1\u05d5\u05e2"
    },
    "discount_value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05d4\u05d4\u05e0\u05d7\u05d4"
    },
    "target_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd/\u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd"
    },
    "target_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea"
    },
    "min_purchase": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e7\u05e0\u05d9\u05d9\u05d4 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "max_uses": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d9\u05de\u05d5\u05e9\u05d9\u05dd \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9"
    },
    "current_uses": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "all",
        "new_clients",
        "returning_clients",
        "vip"
      ],
      "default": "all"
    },
    "created_by": {
      "type": "string",
      "description": "\u05de\u05d8\u05e4\u05dc \u05d0\u05d5 \u05d0\u05d3\u05de\u05d9\u05df"
    }
  },
  "required": [
    "title",
    "type",
    "discount_type",
    "discount_value",
    "start_date",
    "end_date"
  ]
}