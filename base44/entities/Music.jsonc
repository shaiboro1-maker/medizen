      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string",
      "description": "\u05d0\u05dd \u05d4\u05d5\u05e2\u05dc\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05d8\u05e4\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
