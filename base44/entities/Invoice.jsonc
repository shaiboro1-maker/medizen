{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc"
    },
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "appointment_id": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d5\u05e8 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "cancelled"
      ],
      "default": "draft"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "bank_transfer",
        "check"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "therapist_id",
    "client_email",
    "invoice_number",
    "total"
  ]
}