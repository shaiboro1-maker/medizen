{
  "name": "FinancialRecord",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 (\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd, \u05e9\u05db\u05e8 \u05d3\u05d9\u05e8\u05d4, \u05e6\u05d9\u05d5\u05d3 \u05d5\u05db\u05d5')"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d1\u05dc\u05d4/\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "bank_transfer",
        "check",
        "other"
      ]
    },
    "appointment_id": {
      "type": "string",
      "description": "\u05d0\u05dd \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
    }
  },
  "required": [
    "therapist_id",
    "type",
    "amount",
    "date"
  ]
}