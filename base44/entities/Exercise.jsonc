{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "back",
        "neck",
        "shoulder",
        "knee",
        "heel",
        "hip",
        "wrist",
        "general",
        "stretching",
        "strengthening"
      ]
    },
    "video_url": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "is_approved": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category"
  ]
}