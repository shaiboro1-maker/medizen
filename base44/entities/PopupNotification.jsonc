{
  "name": "PopupNotification",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05e9\u05dc\u05d7"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "all_clients",
        "active_clients",
        "specific_clients",
        "new_clients"
      ],
      "description": "\u05e7\u05d4\u05dc \u05d9\u05e2\u05d3"
    },
    "target_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d9\u05d9\u05dc\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "book_appointment",
        "view_service",
        "special_offer",
        "general"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "action_link": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "image_url": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "sent",
        "cancelled"
      ],
      "default": "draft"
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "clicked_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "therapist_id",
    "title",
    "message",
    "target_type"
  ]
}