{
  "name": "Webinar",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "therapist_id": {
      "type": "string"
    },
    "therapist_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "zoom_link": {
      "type": "string"
    },
    "max_participants": {
      "type": "number"
    },
    "current_participants": {
      "type": "number",
      "default": 0
    },
    "recording_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "title",
    "therapist_id",
    "date"
  ]
}