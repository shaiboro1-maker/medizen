{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d9\u05e6\u05e8 \u05d0\u05ea \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05e0\u05d7\u05d4 - \u05d0\u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d5 \u05e1\u05db\u05d5\u05dd \u05e7\u05d1\u05d5\u05e2"
    },
    "discount_value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05d4\u05d4\u05e0\u05d7\u05d4 (\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d5 \u05e9\u05e7\u05dc\u05d9\u05dd)"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "service",
        "course",
        "product",
        "all"
      ],
      "description": "\u05e2\u05dc \u05de\u05d4 \u05d7\u05dc \u05d4\u05e7\u05d5\u05e4\u05d5\u05df"
    },
    "target_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea/\u05e7\u05d5\u05e8\u05e1/\u05de\u05d5\u05e6\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "max_uses": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d9\u05de\u05d5\u05e9\u05d9\u05dd \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9"
    },
    "used_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "therapist_id",
    "code",
    "discount_type",
    "discount_value",
    "applies_to"
  ]
}