{
  "name": "CustomerInteraction",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "therapist_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d8\u05e4\u05dc \u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "appointment",
        "order",
        "contact",
        "chat",
        "review",
        "content_view",
        "search"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4"
    },
    "interaction_subtype": {
      "type": "string",
      "description": "\u05ea\u05ea-\u05e1\u05d5\u05d2 (\u05e9\u05dd \u05e9\u05d9\u05e8\u05d5\u05ea, \u05e9\u05dd \u05de\u05d5\u05e6\u05e8 \u05d5\u05db\u05d5')"
    },
    "details": {
      "type": "object",
      "description": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd"
    },
    "value": {
      "type": "number",
      "description": "\u05e2\u05e8\u05da \u05db\u05e1\u05e4\u05d9 \u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "status": {
      "type": "string",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "interaction_type"
  ]
}