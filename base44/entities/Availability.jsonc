{
  "name": "Availability",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string"
    },
    "day_of_week": {
      "type": "number",
      "description": "0=Sunday, 1=Monday, ... 6=Saturday"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "service_id": {
      "type": "string",
      "description": "\u05d0\u05dd \u05de\u05d5\u05d2\u05d3\u05e8, \u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d6\u05d5 \u05ea\u05e7\u05e4\u05d4 \u05e8\u05e7 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05d6\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "therapist_id",
    "day_of_week",
    "start_time",
    "end_time"
  ]
}