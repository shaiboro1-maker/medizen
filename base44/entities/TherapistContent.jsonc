{
  "name": "TherapistContent",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "workshop",
        "pdf",
        "audio",
        "course"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d5\u05db\u05df"
    },
    "file_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "description": "\u05de\u05e9\u05da \u05d1\u05d3\u05e7\u05d5\u05ea (\u05dc\u05e1\u05e8\u05d8\u05d5\u05e0\u05d9\u05dd/\u05e1\u05d3\u05e0\u05d0\u05d5\u05ea)"
    },
    "is_free": {
      "type": "boolean",
      "default": true
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "exercise",
        "meditation",
        "nutrition",
        "education",
        "workshop",
        "other"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "purchases_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "therapist_id",
    "title",
    "content_type",
    "file_url"
  ]
}