{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "appointment_id": {
      "type": "string",
      "description": "\u05d4\u05ea\u05d5\u05e8 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05de\u05e9\u05d5\u05d9\u05d9\u05da \u05d4\u05e6'\u05d0\u05d8"
    },
    "therapist_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "therapist",
        "client"
      ],
      "description": "\u05de\u05d9 \u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "message": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "appointment_id",
    "therapist_id",
    "client_email",
    "sender_type",
    "message"
  ]
}