{
  "name": "Payment",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "appointment_id": {
      "type": "string",
      "description": "\u05d0\u05dd \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d5\u05e8"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "deposit",
        "full",
        "partial",
        "content"
      ],
      "description": "\u05d3\u05de\u05d9 \u05e8\u05e6\u05d9\u05e0\u05d5\u05ea, \u05ea\u05e9\u05dc\u05d5\u05dd \u05de\u05dc\u05d0, \u05d7\u05dc\u05e7\u05d9, \u05d0\u05d5 \u05ea\u05d5\u05db\u05df"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "cash",
        "bank_transfer",
        "bit",
        "paypal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "transaction_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "therapist_id",
    "client_email",
    "amount",
    "payment_type"
  ]
}