{
  "name": "LeadBotConversation",
  "type": "object",
  "properties": {
    "therapist_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc"
    },
    "lead_name": {
      "type": "string"
    },
    "lead_email": {
      "type": "string"
    },
    "lead_phone": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "enum": [
              "bot",
              "lead"
            ]
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05d9\u05d7\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "converted",
        "cold"
      ],
      "default": "active",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05dc\u05d9\u05d3"
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "\u05e6\u05d9\u05d5\u05df \u05d7\u05d5\u05dd \u05d4\u05dc\u05d9\u05d3 0-100"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "therapist_id"
  ]
}